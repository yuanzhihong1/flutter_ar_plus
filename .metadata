# 此文件记录 Flutter 项目属性，用于工具判断项目能力和执行升级迁移。
#
# 该文件应纳入版本控制，不应手动随意修改。

version:
  revision: "737ba8f885dc774b53b442759999a312c9461e4e"
  channel: "stable"

project_type: plugin

# 记录 flutter migrate 命令所需的平台迁移元数据。
migration:
  platforms:
    - platform: root
      create_revision: 737ba8f885dc774b53b442759999a312c9461e4e
      base_revision: 737ba8f885dc774b53b442759999a312c9461e4e
    - platform: android
      create_revision: 737ba8f885dc774b53b442759999a312c9461e4e
      base_revision: 737ba8f885dc774b53b442759999a312c9461e4e
    - platform: ios
      create_revision: 737ba8f885dc774b53b442759999a312c9461e4e
      base_revision: 737ba8f885dc774b53b442759999a312c9461e4e
    - platform: macos
      create_revision: 737ba8f885dc774b53b442759999a312c9461e4e
      base_revision: 737ba8f885dc774b53b442759999a312c9461e4e

  # 用户自定义区域

  # 相对于此文件、应被迁移工具忽略的本地路径。
  #
  # 不属于模板的文件默认会被忽略。
  unmanaged_files:
    - 'lib/main.dart'
    - 'ios/Runner.xcodeproj/project.pbxproj'
