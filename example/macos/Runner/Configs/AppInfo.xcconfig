// Runner 目标的应用级配置。
//
// 未来这些值可能改为从 pubspec.yaml 等元数据自动生成。
// 在此之前，以下值默认使用项目名称。
//
// 应用名称，默认也会作为 Flutter 窗口标题。
PRODUCT_NAME = flutter_ar_plus_example

// 应用 Bundle 标识符。
PRODUCT_BUNDLE_IDENTIFIER = com.yuanzhihong.flutterArExample

// 应用信息中显示的版权声明。
PRODUCT_COPYRIGHT = Copyright © 2026 com.yuanzhihong. All rights reserved.
